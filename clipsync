#!/usr/bin/env bash
# clipsync — общий буфер обмена компьютера и Android-телефонов (по кабелю и через сервер).
#
# Этот скрипт готовит окружение .venv внутри проекта и управляет службой systemd;
# остальные команды выполняет pc/clipsync.py из .venv.
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
VENV="$ROOT/.venv"
CONF="$ROOT/config.env"
PY="$VENV/bin/python"
SHARE="$VENV/share"
AGENT_SRC="$ROOT/android/src"
AGENT_JAR="$SHARE/clipsync-agent.jar"
SCRCPY_JAR="$SHARE/scrcpy-server.jar"

# Версии загружаемых компонентов и их SHA-256 (проверяются при загрузке)
SCRCPY_VERSION=5.0.1
SCRCPY_SHA256=764eb6f79811d5211fe9df341120882ba9994c7a61b897d7bf3fb662e53bc536
R8_VERSION=9.5.33
R8_SHA256=9743e95de295fb6f5490e21da26536e4d0921809511423122ff20328a572e7f5
R8_JAR="$VENV/lib/r8-$R8_VERSION.jar"

UNIT_NAME=clipsync.service
UNIT_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT_NAME"

say() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*" >&2; }
die() { say "Ошибка: $*"; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

fetch() { # url file sha256
    say "Скачиваю $(basename "$2")…"
    if have curl; then curl -fsSL --retry 3 -o "$2.part" "$1"
    elif have wget; then wget -q -O "$2.part" "$1"
    else die "нужен curl или wget"; fi
    if [ "$(sha256sum "$2.part" | awk '{print $1}')" != "$3" ]; then
        rm -f "$2.part"
        die "контрольная сумма $(basename "$2") не совпала"
    fi
    mv -f "$2.part" "$2"
}

check_requirements() {
    local miss=()
    have python3 || miss+=("python3")
    have python3 && ! python3 -c 'import venv, ensurepip' 2>/dev/null && miss+=("python3-venv")
    have javac || miss+=("JDK 11+ (javac)")
    have curl || have wget || miss+=("curl")
    have sha256sum || miss+=("coreutils (sha256sum)")
    have adb || miss+=("adb (android-tools)")
    have wl-paste || have xclip || miss+=("wl-clipboard (Wayland) или xclip (X11)")
    if [ ${#miss[@]} -gt 0 ]; then
        say "Не хватает: ${miss[*]}"
        die "установите недостающее (см. requirements.txt / README.md) и повторите"
    fi
}

build_agent() {
    local stamp src_hash tmp
    src_hash=$( (cat "$AGENT_SRC"/clipsync/*.java; echo "$R8_VERSION") | sha256sum | awk '{print $1}')
    stamp="$SHARE/clipsync-agent.src"
    if [ -f "$AGENT_JAR" ] && [ "$(cat "$stamp" 2>/dev/null)" = "$src_hash" ]; then
        return 0
    fi
    say "Собираю агент для телефона…"
    tmp=$(mktemp -d)
    javac -nowarn --release 11 -encoding UTF-8 -d "$tmp/classes" "$AGENT_SRC"/clipsync/*.java
    java -cp "$R8_JAR" com.android.tools.r8.D8 --release --min-api 26 \
        --output "$tmp/agent.jar" "$tmp"/classes/clipsync/*.class
    install -Dm644 "$tmp/agent.jar" "$AGENT_JAR"
    echo "$src_hash" >"$stamp"
    rm -rf "$tmp"
}

cmd_setup() {
    check_requirements
    if [ ! -x "$PY" ]; then
        say "Создаю виртуальное окружение $VENV…"
        python3 -m venv "$VENV"
    fi
    "$PY" -m pip install -q --disable-pip-version-check -r "$ROOT/requirements.txt"
    mkdir -p "$SHARE" "$VENV/lib" "$VENV/run"
    [ -f "$SCRCPY_JAR" ] && [ "$(sha256sum "$SCRCPY_JAR" | awk '{print $1}')" = "$SCRCPY_SHA256" ] ||
        fetch "https://github.com/Genymobile/scrcpy/releases/download/v$SCRCPY_VERSION/scrcpy-server-v$SCRCPY_VERSION" \
            "$SCRCPY_JAR" "$SCRCPY_SHA256"
    [ -f "$R8_JAR" ] ||
        fetch "https://dl.google.com/android/maven2/com/android/tools/r8/$R8_VERSION/r8-$R8_VERSION.jar" \
            "$R8_JAR" "$R8_SHA256"
    build_agent
    if [ ! -f "$CONF" ]; then
        install -m600 "$ROOT/config.env.example" "$CONF"
        say "Создан $CONF"
    fi
    if ! grep -qE '^SECRET=.+' "$CONF"; then
        "$PY" "$ROOT/pc/clipsync.py" config SECRET "$("$PY" "$ROOT/server/relay.py" gen-secret)" >/dev/null
        say "Сгенерирован новый SECRET (если есть сервер — возьмите секрет с него: ./clipsync config SECRET …)"
    fi
    chmod 600 "$CONF"
    say "Окружение готово: $VENV"
}

ensure_ready() {
    [ -x "$PY" ] && [ -f "$AGENT_JAR" ] && [ -f "$SCRCPY_JAR" ] && [ -f "$CONF" ] || cmd_setup
    build_agent
}

cmd_install() {
    ensure_ready
    have systemctl || die "systemd не найден: запускайте ./clipsync run из автозапуска сессии"
    mkdir -p "$(dirname "$UNIT_FILE")"
    cat >"$UNIT_FILE" <<EOF
[Unit]
Description=clipsync: общий буфер обмена с телефонами
After=graphical-session.target

[Service]
Type=simple
ExecStart="$ROOT/clipsync" run
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable "$UNIT_NAME" >/dev/null 2>&1
    systemctl --user restart "$UNIT_NAME"
    say "Служба $UNIT_NAME установлена и запущена (стартует при входе в систему)."
}

cmd_uninstall() {
    if [ -f "$UNIT_FILE" ]; then
        systemctl --user disable --now "$UNIT_NAME" 2>/dev/null || true
        rm -f "$UNIT_FILE"
        systemctl --user daemon-reload
        say "Служба удалена"
    else
        say "Служба не установлена"
    fi
}

usage() {
    cat <<EOF
clipsync — общий буфер обмена компьютера и Android-телефонов.

  ./clipsync setup                подготовить окружение .venv (venv, агент для телефона)
  ./clipsync run                  запустить в терминале (Ctrl+C — остановить)
  ./clipsync install              установить и запустить службу systemd пользователя
  ./clipsync uninstall            удалить службу
  ./clipsync restart              перезапустить службу (после правки config.env)
  ./clipsync status               состояние: сервер, служба, телефоны
  ./clipsync logs                 журнал службы
  ./clipsync config КЛЮЧ ЗНАЧЕНИЕ записать параметр (SERVER, SECRET, PHONES, …)
  ./clipsync phone-setup [serial] переустановить агент на телефон
  ./clipsync phone-remove [serial] удалить агент с телефона
  ./clipsync phone-log [serial]   журнал агента на телефоне
  ./clipsync gen-secret           новый случайный секрет
  ./clipsync server [--port N]    relay-сервер здесь же (для проверки)

Настройки: $CONF
EOF
}

case "${1:-}" in
    setup) cmd_setup ;;
    install) cmd_install ;;
    uninstall) cmd_uninstall ;;
    restart) systemctl --user restart "$UNIT_NAME" && say "Служба перезапущена" ;;
    logs) exec journalctl --user -u "$UNIT_NAME" -f ;;
    -h | --help | help | "") usage ;;
    run | phone-setup)
        ensure_ready
        exec "$PY" "$ROOT/pc/clipsync.py" "$@" ;;
    *)
        [ -x "$PY" ] || cmd_setup
        exec "$PY" "$ROOT/pc/clipsync.py" "$@" ;;
esac
