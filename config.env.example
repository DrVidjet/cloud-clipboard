# Настройки clipsync на компьютере. ./clipsync setup копирует этот файл в config.env
# (тот в .gitignore) и сам генерирует SECRET. Поменять значение: ./clipsync config КЛЮЧ ЗНАЧЕНИЕ

# Relay-сервер: адрес:порт. Пусто — только по кабелю, без облака.
#   SERVER=203.0.113.10:8765
SERVER=

# Общий секрет. Одинаковый на всех компьютерах; на телефоны он попадает при настройке.
# Сервер хранит только производный ключ авторизации и не может прочитать буфер обмена.
SECRET=

# Порт для связи с телефоном по кабелю (adb reverse). 0 — не использовать кабель.
USB_PORT=27360

# Серийные номера телефонов (adb devices) через пробел. Пусто — все подключённые.
PHONES=

# Буфер обмена: auto, wayland (wl-clipboard), x11 (xclip)
CLIPBOARD=auto

# Имя этого компьютера в журнале сервера. Пусто — hostname.
NAME=
